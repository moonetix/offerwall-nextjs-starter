# Copy to .env.local and fill in. Never commit real values.
# Find them in your Moonetix dashboard: Offerwalls, your offerwall, Integration (App ID, link hash salt)
# and the Postback page under Incentive tools (postback secret key).
# No NEXT_PUBLIC_ prefix: these must stay on the server.
MOONETIX_APP_ID=your_app_id
MOONETIX_LINK_SALT=your_link_hash_salt
MOONETIX_POSTBACK_KEY=your_postback_secret_key

# Where the JSON file store keeps balances in local development.
MOONETIX_STORE_FILE=.data/moonetix-store.json

# Floating "Earn coins" button on every page for signed-in users. Set to off to hide it.
MOONETIX_FLOATING_BUTTON=on
